{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Node runs the scripts and rivi-bot's review as they are, stripping their types, so one
    // imports another by its .ts name.
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true
  },
  "include": ["scripts", "rivi-bot"]
}
