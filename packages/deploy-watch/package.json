{
  "name": "@rivi-software/deploy-watch",
  "version": "0.1.0",
  "description": "Moves a browser tab that was open across a deploy onto the new build at a moment that loses nothing: the next navigation loads the whole page, a notice can offer the reload, and an error screen that caught a missing chunk reloads instead",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "vite": "8.3.5"
  },
  "keywords": [
    "deploy",
    "version-skew",
    "chunk-load-error",
    "vite",
    "vite-plugin",
    "react",
    "tanstack-router",
    "astro",
    "cloudflare-workers"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rivi-software/tools.git",
    "directory": "packages/deploy-watch"
  },
  "homepage": "https://github.com/rivi-software/tools/tree/main/packages/deploy-watch#readme",
  "bugs": "https://github.com/rivi-software/tools/issues",
  "publishConfig": {
    "access": "public"
  }
}
