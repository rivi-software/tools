{
  "name": "@rivi-software/vite-plugin-zod-jitless",
  "version": "0.1.0",
  "description": "Vite plugin that sets Zod's jitless mode before any browser module builds a schema, so a strict Content-Security-Policy never sees Zod's eval probe",
  "keywords": ["vite", "vite-plugin", "zod", "csp", "content-security-policy", "unsafe-eval"],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vite": "^8.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "zod": "4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rivi-software/tools.git",
    "directory": "packages/vite-plugin-zod-jitless"
  },
  "homepage": "https://github.com/rivi-software/tools/tree/main/packages/vite-plugin-zod-jitless#readme",
  "bugs": "https://github.com/rivi-software/tools/issues",
  "publishConfig": { "access": "public" }
}
