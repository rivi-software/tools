{
  "name": "@rivi-software/cloudflare-deploy",
  "version": "0.1.1",
  "description": "Deploy helpers for Cloudflare Workers apps: environment guards, a post-deploy health check, a REST API client for D1, KV, R2 and Workers for Platforms, skew protection that keeps earlier builds' client files served after a deploy, and test doubles: a fake of that API and a KV namespace that serves stale reads",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cloudflare-api": {
      "types": "./dist/cloudflare-api.d.ts",
      "default": "./dist/cloudflare-api.js"
    },
    "./previous-assets": {
      "types": "./dist/previous-assets.d.ts",
      "default": "./dist/previous-assets.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "bin": {
    "cloudflare-retain-assets": "./dist/retain-assets-cli.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "cloudflare",
    "cloudflare-workers",
    "wrangler",
    "deploy",
    "d1",
    "kv",
    "r2",
    "workers-for-platforms",
    "skew-protection",
    "testing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rivi-software/tools.git",
    "directory": "packages/cloudflare-deploy"
  },
  "homepage": "https://github.com/rivi-software/tools/tree/main/packages/cloudflare-deploy#readme",
  "bugs": "https://github.com/rivi-software/tools/issues",
  "publishConfig": {
    "access": "public"
  }
}
