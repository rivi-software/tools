{
  "name": "rivi-tools",
  "private": true,
  "description": "Tools RIVI Software builds its apps with, published to npm under @rivi-software",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "check": "tsc -p tsconfig.json && pnpm -r run check",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "pnpm -r run test",
    "check:manifests": "node scripts/check-publish-manifests.ts",
    "check:packages": "node scripts/check-packed-imports.ts",
    "verify": "pnpm run check:manifests && pnpm run format:check && pnpm run lint && pnpm run check && pnpm run test && pnpm run build && pnpm run check:packages",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@types/node": "22.20.5",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.18",
    "pnpm": ">=12"
  }
}
